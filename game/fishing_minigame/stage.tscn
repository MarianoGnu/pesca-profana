[sub_resource type="Shader" id="Shader_riqys"]
code = "shader_type canvas_item;

uniform float wave_force: hint_range(0.0, 1.0, 0.1) = 1.0;
uniform float waveness: hint_range(0.0, 50.0, 0.5) = 5.0;
uniform float speed: hint_range(0.0, 20.0, 0.1) = 1.0;

void fragment() {
	vec2 uv = UV;
	uv.y += sin(TIME * speed + uv.x * waveness) * wave_force * 0.1;
	COLOR = texture(TEXTURE, uv) * vec4(COLOR.rgb, 1.0);
}
"

