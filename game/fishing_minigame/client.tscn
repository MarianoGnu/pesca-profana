[sub_resource type="GDScript" id="GDScript_ughtl"]
script/source = "@tool
extends CanvasGroup

@export var _pupils: Array[Node2D]
@export_range(0.0, 50.0, 1.0) var _rand_radius: float

var _timer: Timer
func _ready() -> void:
	_timer = Timer.new()
	add_child(_timer)
	_timer.one_shot = false
	_timer.timeout.connect(_randomize_pupils)
	_timer.start(0.5)


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _randomize_pupils() -> void:
	for p: Node2D in _pupils:
		p.position = Vector2.RIGHT.rotated(2 * PI * randf()) * _rand_radius
"

